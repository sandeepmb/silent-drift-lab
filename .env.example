# silent-drift-lab — copy to .env. Everything runs locally; no API keys.

# ── Model ────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
JUDGE_MODEL=ollama/qwen2.5:7b          # LiteLLM model string used by Opik evaluators

# ── Opik (self-hosted via ./opik.sh, UI at http://localhost:5173) ───────────
OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=silent-drift-lab
TELEMETRY_MODE=native                   # native | otel | off
OPIK_USAGE_REPORT_ENABLED=false         # SDK anonymous usage pings to Comet (off for a quiet console)

# ── OpenTelemetry track (TELEMETRY_MODE=otel) ───────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # the Collector; it forwards to Opik
OTEL_SERVICE_NAME=learning-accelerator

# ── Storage ────────────────────────────────────────────────────────────────
CHECKPOINT_DB=data/checkpoints.db
NOTES_PATH=study_materials/sample_notes

# ── A2A services ───────────────────────────────────────────────────────────
QUIZ_SERVICE_URL=http://localhost:9001
USE_A2A_QUIZ=true
STUDY_BUDDY_URL=http://localhost:9002
USE_STUDY_BUDDY=false                   # CrewAI Study Buddy is optional, see docs/optional-crewai.md

# ── Drift lab ──────────────────────────────────────────────────────────────
DRIFT_SCENARIO=none                     # none | model_swap | prompt_mutation | stale_notes | traffic_shift | tool_fault | verbosity
